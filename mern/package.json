{
  "name": "promo-finder-mern",
  "private": true,
  "version": "1.0.0",
  "description": "Promo Finder as a MERN app (MongoDB + Express + React + Node) — same Kuku look, same pipeline",
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed": "node server/src/seed.js",
    "sync": "node server/src/seed.js",
    "parity": "node scripts/parity.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
