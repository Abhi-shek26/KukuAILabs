# Copy to mern/.env and fill in. The server also reads the repo-root .env,
# so the Python CLI's QUBRID_API_KEY keeps working without copying it here.

# MongoDB (local service, Atlas free tier, or the docker-compose service).
# On a laptop keep this local: the deployed cluster belongs in the host's env vars only.
# Local outputs/ is never ingested into a remote (mongodb+srv) database unless you set
# PROMO_INGEST_ALL=1 — that guard is what keeps client material out of a public deployment.
MONGODB_URI=mongodb://127.0.0.1:27017/promo_finder

# Where the whole stack listens. 127.0.0.1 locally, 0.0.0.0 in a container/PaaS.
HOST=127.0.0.1
PORT=4000

# Pipeline access: the Express API starts `python -m promo_finder run …`
PYTHON_BIN=python

# Folders scanned for shows and the folder runs are written to (relative to the repo root)
PROMO_SHOW_ROOTS=input_pack,uploads,examples
PROMO_OUTPUTS=outputs

# Provider defaults (any OpenAI-compatible URL works)
LLM_BASE_URL=https://platform.qubrid.com/v1
LLM_MODEL=zai-org/GLM-4.7-Flash
# QUBRID_API_KEY=          # or LLM_API_KEY; can also be typed per-run in the UI

# Hosting safety: 1 = every visitor must bring their own key
PROMO_UI_REQUIRE_KEY=0

# On an empty database, seed one rules-only run of examples/demo_show so the UI is not blank.
# Set to 0 to leave the deployment completely empty.
PROMO_SEED_DEMO=1
